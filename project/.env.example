# Copy to `.env.local` for local development (that file is git-ignored).
# On Netlify, set the same names under Site configuration -> Environment variables.
# None of these are ever sent to the browser.

# Admin login for the leaderboard controls. If ADMIN_PASSWORD is not set, the server
# falls back to the app's original built-in password, which is NOT safe for a real
# event: anyone who has seen the old source or bundle knows it. Always set your own.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-the-event

# Optional. Signs admin sessions. Leave unset to let the server generate and store one.
# AUTH_SECRET=

# Optional. Name of the Netlify Blobs store holding the game data. All deploys of a site
# share the default store, so give a preview/branch deploy its own name to isolate its data.
# BLOBS_STORE_NAME=barcode-game

# Optional, local development only. Where `npm run dev` / `npm run preview` keep their data.
# Give a second dev server its own file so the two do not share (or overwrite) results.
# DEV_DATA_FILE=.data/dev-store.json
